{
  "expo": {
    "name": "Noctwolf",
    "slug": "werewolf-manager",
    "version": "1.0.1",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B14",
    "web": {
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.loupgarou.game",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "This app needs local network access to host game rooms and connect to players.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "android": {
      "package": "com.loupgarou.game",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04060A"
      },
      "permissions": [
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "78db7f9e-3012-45f6-b3a6-f2cc68ce33fb"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#04060A"
        }
      ]
    ]
  }
}
