{
  "expo": {
    "name": "WerewolfManager",
    "slug": "werewolf-manager",
    "version": "1.0.0",
    "newArchEnabled": false,
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B14",
    "androidStatusBar": {
      "backgroundColor": "#070B14",
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#070B14",
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "com.loupgarou.game",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app needs local network access to host game rooms and connect to players.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "android": {
      "package": "com.loupgarou.game",
      "permissions": [
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "78db7f9e-3012-45f6-b3a6-f2cc68ce33fb"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}
